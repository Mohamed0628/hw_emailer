# Local discovery/email configuration. Copy to .env; never commit actual secrets.
# Discovery --dry-run and application --dry-run require no notification credentials.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_TO=

# Optional Twilio SMS, disabled in config/settings.yaml by default.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SMS_TO=

# AUTO_SAFE/PREPARE_ONLY use the deterministic local browser path and require no LLM.
# AUTO_ELIGIBLE uses browser-use for agentic form execution.
OPENAI_API_KEY=
# Optional overrides for an OpenAI-compatible endpoint/model:
# BROWSER_AGENT_API_KEY=
# BROWSER_AGENT_BASE_URL=
# BROWSER_AGENT_MODEL=gpt-4o
# Optional persistent Chrome profile for sites that require login:
# BROWSER_AGENT_USER_DATA_DIR=
