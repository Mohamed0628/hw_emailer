# Local discovery/email configuration. Copy to .env; never commit actual secrets.
# Discovery --dry-run and application --dry-run require no notification credentials.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_TO=

# Optional Twilio SMS, disabled in config/settings.yaml by default.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SMS_TO=

# Applications use config/candidate.yaml and local resumes. No LLM API key required.
